{
    "modName": "NamesOfTheMojave",
    "displayName": "Names of the Mojave",
    "saveFile": "NamesOfTheMojave.ini",
    "minMCMVersion": 1.6,
    "requirements": [
        { "type": "file", "file": "NVSE/plugins/scripts/ln_NamesOfTheMojave.txt" }
    ],
    "submenus": {
        "1": {
            "active": 1,
            "enable": 1,
            "columns": 2,
            "listTitle": "Settings",
            "pageTitle": "Names of the Mojave",
            "options": {
                "1": {
                    "type": 0,
                    "enable": 1,
                    "title": "General"
                },
                "3": {
                    "type": 5,
                    "enable": 1,
                    "title": "Enabled",
                    "mouse": "Off stops naming, and NPCs this mod named get their original names back. On names them again, with the same names.",
                    "vars": [
                        { "form": "PlayerRef", "auxVar": "*NotM:Enabled", "key": 0, "configINI": "General:Enabled", "default": 1 }
                    ]
                },
                "4": {
                    "type": 5,
                    "enable": 1,
                    "title": "Use titles",
                    "mouse": "Puts the game's ranks before a name, e.g. Ranger Barker. Off puts a first name in place of the rank, e.g. Erik Barker.",
                    "vars": [
                        { "form": "PlayerRef", "auxVar": "*NotM:UseTitles", "key": 0, "configINI": "General:UseTitles", "default": 1 }
                    ]
                },
                "5": {
                    "type": 5,
                    "enable": 1,
                    "title": "Show role after name",
                    "mouse": "Shows the original role after the name, e.g. Mike Dawson (Powder Ganger).",
                    "vars": [
                        { "form": "PlayerRef", "auxVar": "*NotM:ShowRole", "key": 0, "configINI": "General:ShowRole", "default": 0 }
                    ]
                },
                "9": {
                    "type": 0,
                    "enable": 1,
                    "title": "Debug"
                },
                "11": {
                    "type": 2,
                    "enable": 1,
                    "title": "Scan interval",
                    "mouse": "Seconds between scans for newly spawned actors (ignored when fast traveling, transitioning, etc.)",
                    "suffix": " s",
                    "scale": {
                        "valueDecimal": 0,
                        "valueIncrement": 1,
                        "valueMin": 1,
                        "valueMax": 60
                    },
                    "vars": [
                        { "form": "PlayerRef", "auxVar": "*NotM:ScanInterval", "key": 0, "configINI": "General:ScanInterval", "default": 10 }
                    ]
                },
                "12": {
                    "type": 2,
                    "enable": 1,
                    "title": "Name seed",
                    "mouse": "WARNING: Changing this will change the names of all the NPC's named by this mod. Same Number = Same seed though, so if you remember your original after changing you can revert back.",
                    "scale": {
                        "valueDecimal": 0,
                        "valueIncrement": 1,
                        "valueMin": 1,
                        "valueMax": 10000
                    },
                    "vars": [
                        { "form": "PlayerRef", "auxVar": "NotMSeed", "key": 0 }
                    ]
                },
                "14": {
                    "type": 7,
                    "enable": 1,
                    "title": "Version",
                    "string": { "form": "PlayerRef", "auxVar": "*NotM:Version", "key": 0 }
                }
            }
        }
    }
}
