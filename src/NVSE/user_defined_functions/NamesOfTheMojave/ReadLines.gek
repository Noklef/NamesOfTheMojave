; Lines starting with # are comments and are skipped. The first empty line ends the list.
; GECK wiki stuff:
;   - https://geckwiki.com/index.php?title=ReadStringFromFile
;   - https://geckwiki.com/index.php?title=AuxiliaryVariableSetString

; This is the main logic around loading any list; it's just going line-by-line
string_var sFilePath    ; The file to read, I.E. "Data/Config/NamesOfTheMojave/Names/NOTM_legion/male.txt"
string_var sNoteName    ; The note to fill, I.E. "*NotM:NOTM_legion:male"
string_var sLine        ; The line we are reading
int iLineNumber         ; Which line we are on. Starts at 1
int iEntryCount         ; How many entries we kept (the answer we give back)

begin Function {sFilePath, sNoteName}
    ; Empty the note first, so loading again does not add the names twice
    player.AuxVarErase (sNoteName)
    let iLineNumber := 1 ; Start from line 1

    ; While `true`, keep running until we don't have any lines to go through
    while 1 
        ; Read the next line. Empty = an empty line, the end of the file, or no file at all
        let sLine := ReadStringFromFile (sFilePath) iLineNumber 1

        ; Length of 0 means the line's over (this assumes there's no gaps in the .txt files)
        if eval (sv_Length sLine) == 0
            break
        elseif eval sLine[0:0] != "#" ; If it's a comment, we -1 since comments don't count to the total
            player.AuxVarSetStr (sNoteName) (sLine) -1
        endif

        let iLineNumber += 1 ; Bump the line count up
    loop

    let iEntryCount := player.AuxVarSize (sNoteName)
    SetFunctionValue iEntryCount
end
