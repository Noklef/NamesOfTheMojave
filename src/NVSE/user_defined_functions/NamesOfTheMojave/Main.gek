; GECK wiki stuff:
;   - https://geckwiki.com/index.php?title=AuxiliaryVariableSetFloat
;   - https://geckwiki.com/index.php?title=GetINIFloat
;   - https://geckwiki.com/index.php?title=CompileScript
;   - https://geckwiki.com/index.php?title=SetOnMenuOpenEventHandler
;   - https://geckwiki.com/index.php?title=SetGameMainLoopCallback
;   - https://geckwiki.com/index.php?title=WriteStringToFile

ref rLoadConfigScript   ; The config loader (LoadConfig.gek), ready to run
ref rTickScript         ; The scan timer (Tick.gek), ready to run
float fPlaythroughSeed  ; The playthrough number. Same number = same names
float fScanInterval     ; Seconds between scans, from the INI


; This loader runs when the game loads / new game is set
; We're saving only the seed each run; since that's what drives the names (stored on the player)
begin Function {}

    ; ====================================
    ; Setting the seed for the playthrough
    ; ====================================

    ; The seed we set defines what names are given to NPC's, so "Prospector" for instance will get a new name
    ; ON EACH PLAYTHROUGH, not each save / load
    let fPlaythroughSeed := player.AuxVarGetFlt "NotMSeed"
    if fPlaythroughSeed < 1 || fPlaythroughSeed > 10000 ; No seed yet, or one from an old version outside the slider's range
        let fPlaythroughSeed := floor (Rand 1 10001) ; 1 - 10000, the MCM slider's range
        player.AuxVarSetFlt "NotMSeed" fPlaythroughSeed
    endif

    ; The seed the names use now. Tick re-names the NPCs when MCM changes the seed
    player.AuxVarSetFlt "*NotM:SeedShown" fPlaythroughSeed

    ; ==================================================================
    ; Settings: INI -> notes on the player (MCM reads and changes these)
    ; ==================================================================

    ; Setup the scan interval, and fix it if it's invalid
    let fScanInterval := GetINIFloat "General:ScanInterval" "NamesOfTheMojave.ini"
    if fScanInterval < 1 ; Missing or broken setting: use 10 seconds
        let fScanInterval := 10
    endif

    ; Set all the MCM options we need
    ; MCM INI Options
    player.AuxVarSetStr "*NotM:Version" "1.0"
    player.AuxVarSetFlt "*NotM:ScanInterval" fScanInterval
    player.AuxVarSetFlt "*NotM:Enabled" (GetINIFloat "General:Enabled" "NamesOfTheMojave.ini")
    player.AuxVarSetFlt "*NotM:UseTitles" (GetINIFloat "General:UseTitles" "NamesOfTheMojave.ini")
    player.AuxVarSetFlt "*NotM:ShowRole" (GetINIFloat "General:ShowRole" "NamesOfTheMojave.ini")

    ; Copying those references to
    player.AuxVarSetFlt "*NotM:EnabledShown" (player.AuxVarGetFlt "*NotM:Enabled")
    player.AuxVarSetFlt "*NotM:ShowRoleShown" (player.AuxVarGetFlt "*NotM:ShowRole")
    player.AuxVarSetFlt "*NotM:UseTitlesShown" (player.AuxVarGetFlt "*NotM:UseTitles")

    ; ================================================================
    ; Scripts: compile once, store on the player for the other scripts
    ; ================================================================

    ; The logger goes first, so every line after this reaches the log file.
    ; 0 = start the file again, so it only has lines from this load
    player.AuxVarSetRef "*NotM:Log" (CompileScript "NamesOfTheMojave/Log.gek")
    WriteStringToFile "NamesOfTheMojave.log" 0 "[NotM] Log started"

    ; Compiles the scripts we're going to be using for the mod
    player.AuxVarSetRef "*NotM:ReadLines" (CompileScript "NamesOfTheMojave/ReadLines.gek")
    player.AuxVarSetRef "*NotM:Hash" (CompileScript "NamesOfTheMojave/Hash.gek")
    player.AuxVarSetRef "*NotM:ChoosePool" (CompileScript "NamesOfTheMojave/ChoosePool.gek")
    player.AuxVarSetRef "*NotM:PickName" (CompileScript "NamesOfTheMojave/PickName.gek")
    player.AuxVarSetRef "*NotM:ShowName" (CompileScript "NamesOfTheMojave/ShowName.gek")
    player.AuxVarSetRef "*NotM:NameNPC" (CompileScript "NamesOfTheMojave/NameNPC.gek")
    player.AuxVarSetRef "*NotM:Scan" (CompileScript "NamesOfTheMojave/Scan.gek")

    ; ===============================================
    ; Config: plugins, rules and pools from the files
    ; ===============================================

    ; Load every rule we're going to be using, that's defined from the files
    let rLoadConfigScript := CompileScript "NamesOfTheMojave/LoadConfig.gek"
    Call rLoadConfigScript

    ; ============================================
    ; Start: first scan, dialogue name, scan timer
    ; ============================================

    ; Tick runs the first scan about 1 second into gameplay
    player.AuxVarSetFlt "*NotM:SecondsSinceScan" (fScanInterval - 1)

    ; Handler to change the name that appears for the dialogue window
    SetOnMenuOpenEventHandler (CompileScript "NamesOfTheMojave/DialogName.gek") 1 1009

    ; Register the tick script
    ; 1 = add it, 30 = frames between calls, 9 = flags 1 + 8 (only during gameplay + removed on load or main menu)
    let rTickScript := CompileScript "NamesOfTheMojave/Tick.gek"
    SetGameMainLoopCallback rTickScript 1 30 9
end
