; GECK wiki stuff:
;   - https://geckwiki.com/index.php?title=GetFilesInFolder
;   - https://geckwiki.com/index.php?title=GetModIndex
;   - https://geckwiki.com/index.php?title=Sv_Split
;   - https://geckwiki.com/index.php?title=Ar_Sort
;   - https://geckwiki.com/index.php?title=Ar_Keys
ref rReadLinesScript        ; The file reader (ReadLines.gek)
ref rLoadPoolScript         ; The pool loader (LoadPool.gek)
array_var aFileNames        ; The files found in a folder
array_var aRuleParts        ; One rule split at "|": [name, pools]
array_var aRules            ; The rules in use: NPC name -> pools. A later file replaces an earlier rule
array_var aRuleNames        ; The NPC names in aRules, to go through them one by one
array_var aPoolNames        ; A rule's pools, split at ","
array_var aUsedPools        ; Every pool loaded so far, so each is loaded once
string_var sConfigFolder    ; The Config folder
string_var sFileName        ; The file we are reading
string_var sLine            ; The line we are reading
string_var sRuleName        ; The NPC name a rule is for, I.E. 'Raider'
string_var sRulePools       ; The pools that rule uses, I.E. 'NOTM_wasteland' or 'A,B'
string_var sPoolName        ; One pool, I.E. 'NOTM_wasteland'
int iEntryCount             ; Lines read from one file, not counting # comments
int iFileIndex              ; Which file we are on (counter)
int iEntryIndex             ; Which line we are on (counter)
int iRuleIndex              ; Which rule we are on (counter)
int iPoolIndex              ; Which pool we are on (counter)
int iPluginIndex            ; A plugin's load order number. 255 = not installed

; This one reads all the files in the config folder. I.E. which plugins to use, the rules, and their pools
begin Function {}
    ; LoadPool is only used here, so it is compiled here (Main compiles the shared scripts)
    let rReadLinesScript := player.AuxVarGetRef "*NotM:ReadLines"
    let rLoadPoolScript := CompileScript "NamesOfTheMojave/LoadPool.gek"
    let sConfigFolder := "Data/Config/NamesOfTheMojave/"
    ; Empty lists to fill as we read (names as keys, so each rule and pool is in there once)
    let aRules := ar_Construct "stringmap"
    let aUsedPools := ar_Construct "stringmap"

    ; ==============================================
    ; Plugins: whose NPCs may be named
    ; ==============================================

    ; Find the .txt files. This path starts in Data, and gives back file names only
    let aFileNames := GetFilesInFolder "Config/NamesOfTheMojave/Plugins" "*.txt"

    ; Read each file into a note, then go through its lines (one plugin name per line)
    let iFileIndex := 0
    while iFileIndex < (ar_Size aFileNames)
        let sFileName := aFileNames[iFileIndex]
        let iEntryCount := Call rReadLinesScript (sConfigFolder + "Plugins/" + sFileName) "*NotM:PluginLines"
        let iEntryIndex := 0
        while iEntryIndex < iEntryCount
            ; Save the plugin by its load order number, because that is what Scan finds on an NPC.
            ; Plugins that are not installed (255) are skipped, so listing a missing mod does no harm
            let sLine := player.AuxVarGetStr "*NotM:PluginLines" iEntryIndex
            let iPluginIndex := GetModIndex (sLine)
            if iPluginIndex < 255
                player.AuxVarSetFlt (sv_Construct "*NotM:UsePlugin:%g" iPluginIndex) 1
            endif
            let iEntryIndex += 1
        loop
        let iFileIndex += 1
    loop

    ; ==============================================
    ; Rules: which NPC names get which pools
    ; ==============================================

    ; Sort the files A to Z. MO2 can list them in any order, and the order decides which rule wins
    let aFileNames := GetFilesInFolder "Config/NamesOfTheMojave/Rules" "*.txt"
    if eval (ar_Size aFileNames) > 1
        let aFileNames := ar_Sort aFileNames
    endif

    ; Read each file into a note, then go through its lines (one rule per line)
    let iFileIndex := 0
    while iFileIndex < (ar_Size aFileNames)
        let sFileName := aFileNames[iFileIndex]
        let iEntryCount := Call rReadLinesScript (sConfigFolder + "Rules/" + sFileName) "*NotM:RuleLines"
        let iEntryIndex := 0
        while iEntryIndex < iEntryCount
            ; Split 'Name|pools' at the |, I.E. 'Raider|NOTM_wasteland' -> [Raider, NOTM_wasteland]
            let sLine := player.AuxVarGetStr "*NotM:RuleLines" iEntryIndex
            let aRuleParts := sv_Split (sLine) "|"
            ; No | or more than one is a typo: the line is skipped
            if eval (ar_Size aRuleParts) == 2
                ; Name|- : remove the rule an earlier file made (and any copy stored on an earlier load)
                if eval aRuleParts[1] == "-"
                    ar_Erase aRules (aRuleParts[0])
                    player.AuxVarErase ("*NotM:Rule:" + aRuleParts[0])
                ; Name|pool or Name|A,B: these pools replace any earlier rule.
                ; Nothing before or after the | is a typo: the line is skipped
                elseif eval (sv_Length (aRuleParts[0])) > 0 && (sv_Length (aRuleParts[1])) > 0
                    let aRules[aRuleParts[0]] := aRuleParts[1]
                endif
            endif
            let iEntryIndex += 1
        loop
        let iFileIndex += 1
    loop

    ; ==============================================
    ; Pools: store each rule in use, and load its pools
    ; ==============================================

    ; Only rules still in use after all files are read get here, so a removed rule loads no pools
    let aRuleNames := ar_Keys aRules
    let iRuleIndex := 0
    while iRuleIndex < (ar_Size aRuleNames)
        let sRuleName := aRuleNames[iRuleIndex]
        let sRulePools := aRules[sRuleName]
        player.AuxVarSetStr ("*NotM:Rule:" + sRuleName) (sRulePools)

        ; Load each pool this rule uses, once per game load
        let aPoolNames := sv_Split (sRulePools) ","
        let iPoolIndex := 0
        while iPoolIndex < (ar_Size aPoolNames)
            let sPoolName := aPoolNames[iPoolIndex]
            ; Skip empty bits from a stray comma (A,,B), and pools already loaded
            if eval (sv_Length sPoolName) > 0 && (ar_HasKey aUsedPools sPoolName) == 0
                let aUsedPools[sPoolName] := 1
                Call rLoadPoolScript (sPoolName)
            endif
            let iPoolIndex += 1
        loop
        let iRuleIndex += 1
    loop
end
