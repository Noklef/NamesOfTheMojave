; GECK wiki stuff:
;   - https://geckwiki.com/index.php?title=GetFilesInFolder
;   - https://geckwiki.com/index.php?title=Sv_Split
;   - https://geckwiki.com/index.php?title=Ar_Sort
;   - https://geckwiki.com/index.php?title=Ar_Keys
ref rReadLinesScript        ; The file reader (ReadLines.gek)
ref rLoadPoolScript         ; The pool loader (LoadPool.gek)
ref rLoadPluginsScript      ; The plugins reader (LoadPlugins.gek)
ref rLogScript              ; The logger (Log.gek)
array_var aFileNames       ; The files found in a folder
array_var aRuleParts        ; One rule split at "|": [name, pools] or [name, pools, title]
array_var aRules            ; The rules in use: NPC name -> pools. A later file replaces an earlier rule
array_var aRuleTitles       ; The rules in use: NPC name -> title ("" = no title)
array_var aRuleNames        ; The NPC names in aRules, to go through them one by one
array_var aPoolNames        ; A rule's pools, split at ","
array_var aUsedPools        ; Every pool loaded so far, so each is loaded once
string_var sFileName        ; The file we are reading
string_var sLine            ; The line we are reading
string_var sRuleName        ; The NPC name a rule is for, I.E. 'Raider'
string_var sRulePools       ; The pools that rule uses, I.E. 'NOTM_wasteland' or 'A,B'
string_var sRuleTitle       ; The title that rule puts before the name, I.E. 'Knight' ("" = no title)
string_var sPoolName        ; One pool, I.E. 'NOTM_wasteland'
string_var sVersion         ; The mod version, for the startup line
int iEntryCount             ; Lines read from one file, not counting # comments
int iFileIndex              ; Which file we are on (counter)
int iEntryIndex             ; Which line we are on (counter)
int iRuleIndex              ; Which rule we are on (counter)
int iPoolIndex              ; Which pool we are on (counter)
int iPluginCount            ; How many listed plugins are installed, for the startup line
int iRuleCount              ; How many rules are in use, for the startup line
int iPoolCount              ; How many pools are in use, for the startup line

; This one reads all the files in the config folder. I.E. which plugins to use, the rules, and their pools
begin Function {}
    ; LoadPlugins and LoadPool are only used here, so they are compiled here (Main compiles the shared scripts)
    let rReadLinesScript := player.AuxVarGetRef "*NotM:ReadLines"
    let rLoadPluginsScript := CompileScript "NamesOfTheMojave/LoadPlugins.gek"
    let rLoadPoolScript := CompileScript "NamesOfTheMojave/LoadPool.gek"
    let rLogScript := player.AuxVarGetRef "*NotM:Log"

    ; Empty lists to fill as we read (names as keys, so each rule and pool is in there once)
    let aRules := ar_Construct "stringmap"
    let aRuleTitles := ar_Construct "stringmap"
    let aUsedPools := ar_Construct "stringmap"

    ; ==============================================
    ; Plugins: whose NPCs may be named
    ; ==============================================

    let iPluginCount := Call rLoadPluginsScript

    ; ==============================================
    ; Rules: which NPC names get which pools
    ; ==============================================

    ; Sort the files A to Z. MO2 can list them in any order, and the order decides which rule wins
    let aFileNames := GetFilesInFolder "Config/NamesOfTheMojave/Rules" "*.txt"
    if eval (ar_Size aFileNames) > 1
        let aFileNames := ar_Sort aFileNames
    endif

    ; Read each file into a note, then go through its lines (one rule per line)
    let iFileIndex := 0
    while iFileIndex < (ar_Size aFileNames)
        let sFileName := aFileNames[iFileIndex]
        let iEntryCount := Call rReadLinesScript ("Data/Config/NamesOfTheMojave/Rules/" + sFileName) "*NotM:RuleLines"
        let iEntryIndex := 0

        while iEntryIndex < iEntryCount
            ; Split 'Name|pools' or 'Name|pools|title' at the |, I.E. 'NCR Ranger|NOTM_wasteland|Ranger' -> [NCR Ranger, NOTM_wasteland, Ranger]
            let sLine := player.AuxVarGetStr "*NotM:RuleLines" iEntryIndex
            let aRuleParts := sv_Split (sLine) "|"

            ; No | or more than two is a typo: the line is skipped. sv_Split drops empty parts,
            if eval (ar_Size aRuleParts) < 2 || (ar_Size aRuleParts) > 3
                Call rLogScript "WARN" (sv_Construct "bad rule line [%z] in Rules/%z" sLine sFileName)
            else
                let sRuleName := aRuleParts[0]
                let sRulePools := aRuleParts[1]
                let sRuleTitle := ""
                if eval (ar_Size aRuleParts) == 3
                    let sRuleTitle := aRuleParts[2]
                endif
                ; Name|- : remove the rule an earlier file made (and any copy stored on an earlier load)
                if eval sRulePools == "-"
                    Call rLogScript "DEBUG" (sv_Construct "Rules/%z removes the rule for %z" sFileName sRuleName)
                    ar_Erase aRules sRuleName
                    ar_Erase aRuleTitles sRuleName
                    player.AuxVarErase ("*NotM:Rule:" + sRuleName)
                    player.AuxVarErase ("*NotM:Title:" + sRuleName)
                ; Name|pool or Name|A,B (with or without |title): replaces any earlier rule, title too
                else
                    ; Shows add-on authors which file won
                    if eval (ar_HasKey aRules sRuleName) == 1
                        Call rLogScript "DEBUG" (sv_Construct "Rules/%z replaces the rule for %z" sFileName sRuleName)
                    endif
                    let aRules[sRuleName] := sRulePools
                    let aRuleTitles[sRuleName] := sRuleTitle
                endif
            endif

            let iEntryIndex += 1
        loop

        let iFileIndex += 1
    loop

    ; An empty folder, or every rule removed
    let iRuleCount := ar_Size aRules
    if iRuleCount == 0
        Call rLogScript "WARN" "Rules/ has no rules in use, no actor will be named"
    endif

    ; ==============================================
    ; Pools: store each rule in use, and load its pools
    ; ==============================================

    ; Only rules still in use after all files are read get here, so a removed rule loads no pools
    let aRuleNames := ar_Keys aRules
    let iRuleIndex := 0
    while iRuleIndex < (ar_Size aRuleNames)
        let sRuleName := aRuleNames[iRuleIndex]
        let sRulePools := aRules[sRuleName]
        player.AuxVarSetStr ("*NotM:Rule:" + sRuleName) (sRulePools)
        player.AuxVarSetStr ("*NotM:Title:" + sRuleName) (aRuleTitles[sRuleName])

        ; Load each pool this rule uses, once per game load
        let aPoolNames := sv_Split (sRulePools) ","
        let iPoolIndex := 0

        while iPoolIndex < (ar_Size aPoolNames)
            let sPoolName := aPoolNames[iPoolIndex]
            ; Skip pools already loaded.
            if eval (ar_HasKey aUsedPools sPoolName) == 0
                let aUsedPools[sPoolName] := 1
                Call rLoadPoolScript (sPoolName)
            endif
            
            let iPoolIndex += 1
        loop

        let iRuleIndex += 1
    loop

    ; ==============================================
    ; Startup line (helps with bug reports)
    ; ==============================================

    ; Put the values in variables first, then print them
    let sVersion := player.AuxVarGetStr "*NotM:Version"
    let iPoolCount := ar_Size aUsedPools
    Call rLogScript "INFO" (sv_Construct "Names of the Mojave %z: %g rules, %g pools, %g plugins" sVersion iRuleCount iPoolCount iPluginCount)
end
