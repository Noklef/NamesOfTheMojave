; GECK wiki stuff:
;   - https://geckwiki.com/index.php?title=GetFilesInFolder
;   - https://geckwiki.com/index.php?title=GetModIndex
ref rReadLinesScript        ; The file reader (ReadLines.gek)
ref rLogScript              ; The logger (Log.gek)
array_var aFileNames        ; The files found in the Plugins folder
string_var sFileName        ; The file we are reading
string_var sLine            ; The line we are reading
int iEntryCount             ; Lines read from one file, not counting # comments
int iFileIndex              ; Which file we are on (counter)
int iEntryIndex             ; Which line we are on (counter)
int iPluginIndex            ; A plugin's load order number. 255 = not installed
int iPluginCount            ; How many listed plugins are installed (the answer we give back)

; Plugins: whose NPCs may be named. Reads every file in Plugins/
begin Function {}
    let rReadLinesScript := player.AuxVarGetRef "*NotM:ReadLines"
    let rLogScript := player.AuxVarGetRef "*NotM:Log"
    let iPluginCount := 0

    ; Find the .txt files. This path starts in Data, and gives back file names only
    let aFileNames := GetFilesInFolder "Config/NamesOfTheMojave/Plugins" "*.txt"

    ; Read each file into a note, then go through its lines (one plugin name per line)
    let iFileIndex := 0
    while iFileIndex < (ar_Size aFileNames)
        let sFileName := aFileNames[iFileIndex]
        let iEntryCount := Call rReadLinesScript ("Data/Config/NamesOfTheMojave/Plugins/" + sFileName) "*NotM:PluginLines"
        let iEntryIndex := 0

        while iEntryIndex < iEntryCount
            ; Save the plugin by its load order number, because that is what Scan finds on an NPC.
            ; Plugins that are not installed (255) are skipped, so listing a missing mod does no harm
            let sLine := player.AuxVarGetStr "*NotM:PluginLines" iEntryIndex
            let iPluginIndex := GetModIndex (sLine)
            if iPluginIndex < 255
                player.AuxVarSetFlt (sv_Construct "*NotM:UsePlugin:%g" iPluginIndex) 1
                let iPluginCount += 1
            endif
            let iEntryIndex += 1
        loop
        let iFileIndex += 1
    loop

    ; An empty folder, or none of the listed plugins installed
    if iPluginCount == 0
        Call rLogScript "WARN" "Plugins/ lists no installed plugin, no actor will be named"
    endif

    SetFunctionValue iPluginCount
end
