; GECK wiki stuff:
;   - https://geckwiki.com/index.php?title=SetGameMainLoopCallback
;   - https://geckwiki.com/index.php?title=GetSecondsPassed
;   - https://geckwiki.com/index.php?title=GetParentCell

ref rCurrentCell        ; The area you are in now
ref rScanScript         ; The NPC scanner (Scan.gek)
float fSecondsSinceScan ; Seconds since the last scan
float fScanInterval     ; Seconds between scans (INI or MCM)

begin Function {}
    ; Get the scan interval, in case MCM changed it
    let fScanInterval := player.AuxVarGetFlt "*NotM:ScanInterval"

    ; Logic is: time since last tick + time since last scan
    ; GetSecondsPassed gives the time of one frame (measured in game), and a tick is 30 frames
    let fSecondsSinceScan := (player.AuxVarGetFlt "*NotM:SecondsSinceScan") + (GetSecondsPassed * 30)

    ; When we go somewhere new. Door, fast travel, walking into a new cell, etc.
    let rCurrentCell := player.GetParentCell
    if eval rCurrentCell != player.AuxVarGetRef "*NotM:LastCell"
        player.AuxVarSetRef "*NotM:LastCell" rCurrentCell
        ; Scan in about 1 second: the new NPCs need a moment to appear
        let fSecondsSinceScan := GetMaxOf fSecondsSinceScan (fScanInterval - 1)
    endif

    ; ShowRole changed (MCM): scan now, so the NPCs around you show the change straight away
    if eval (player.AuxVarGetFlt "*NotM:ShowRole") != (player.AuxVarGetFlt "*NotM:ShowRoleShown")
        player.AuxVarSetFlt "*NotM:ShowRoleShown" (player.AuxVarGetFlt "*NotM:ShowRole")
        let fSecondsSinceScan := fScanInterval
    endif

    ; Seed changed (MCM): scan now, so the NPCs around you get their new names straight away
    if eval (player.AuxVarGetFlt "NotMSeed") != (player.AuxVarGetFlt "*NotM:SeedShown")
        player.AuxVarSetFlt "*NotM:SeedShown" (player.AuxVarGetFlt "NotMSeed")
        let fSecondsSinceScan := fScanInterval
    endif

    ; UseTitles changed (MCM): scan now, so the NPCs around you get their new names straight away
    if eval (player.AuxVarGetFlt "*NotM:UseTitles") != (player.AuxVarGetFlt "*NotM:UseTitlesShown")
        player.AuxVarSetFlt "*NotM:UseTitlesShown" (player.AuxVarGetFlt "*NotM:UseTitles")
        let fSecondsSinceScan := fScanInterval
    endif

    ; Name NPC's and then reset the count to re-scan
    if fSecondsSinceScan >= fScanInterval
        let fSecondsSinceScan := 0
        let rScanScript := player.AuxVarGetRef "*NotM:Scan"
        Call rScanScript
    endif

    player.AuxVarSetFlt "*NotM:SecondsSinceScan" fSecondsSinceScan
end
