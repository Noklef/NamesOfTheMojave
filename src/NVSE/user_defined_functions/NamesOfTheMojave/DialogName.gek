; GECK wiki stuff:
;   - https://geckwiki.com/index.php?title=SetOnMenuOpenEventHandler
;   - https://geckwiki.com/index.php?title=GetMenuTargetRef
;   - https://geckwiki.com/index.php?title=SetUIString

; Menu open handler for the dialog menu, this is more a "Just in case", since maybe if a mod adds 
; random NPC's actual dialog options, this should catch that and do it
int iMenuCode           ; Menu code passed by the event (always 1009 here)
ref rSpeaker            ; The NPC we are talking to
string_var sDisplayName ; The NPC's display name (the one we gave them)

begin Function {iMenuCode}
    let rSpeaker := GetMenuTargetRef iMenuCode ; iMenuCode is passed by the event: 1009, the DialogMenu code
    if eval rSpeaker
        let sDisplayName := rSpeaker.LNGetName          ; Display name (I.E. 'Mike Dawson'), or the base name if we never renamed them
        if eval sDisplayName != rSpeaker.GetName        ; Base name (I.E. 'Prospector'). Different = we renamed them
            ; Path checked against the vanilla and Vanilla UI Plus menu files. Tested in game with Vanilla UI Plus
            SetUIString "DialogMenu\NOGLOW_BRANCH\DM_SpeakerNameLabel\string" (sDisplayName)
        endif
    endif
end
