; Names generic actors near the player.
; An actor is named if: not a creature, its base name has a rule, and its base record
; (leveled base for leveled spawns) comes from an allowed plugin.
; Pass 1 collects names already shown by loaded actors. Pass 2 names the rest and
; re-rolls a name that is already in use (up to 8 attempts). With ShowRole=1 the role is part of the name.
; Already-named actors (ref name differs from base name) are skipped.
; Other mods can opt an actor out: rActor.AuxVarSetFlt "NotMSkip" 1 (public aux var).
ref rPlayer
ref rActor
ref rBase
ref rPick
array_var aUsed
int iCount
int iModIdx
int iTry
string_var sBase
string_var sPool
string_var sName

begin Function {}
	let rPlayer := GetFormFromMod "FalloutNV.esm" "000014"
	let rPick := rPlayer.AuxVarGetRef "*NotM:Pick"
	let aUsed := ar_Construct "stringmap"

	let rActor := GetFirstRef 200 1
	while rActor
		let sName := rActor.LNGetName
		let aUsed[sName] := 1
		let rActor := GetNextRef
	loop

	let rActor := GetFirstRef 200 1
	while rActor
		let sBase := rActor.GetName
		let sName := rActor.LNGetName
		if eval rActor != rPlayer && sName == sBase && (rActor.GetIsCreature) == 0 && (rActor.AuxVarGetFlt "NotMSkip") == 0
			let sPool := rPlayer.AuxVarGetStr ("*NotM:R:" + sBase)
			if eval (sv_Length sPool) > 0
				let rBase := rActor.GetLeveledActorBase
				let iModIdx := GetSourceModIndex rBase
				if eval (rPlayer.AuxVarGetFlt (sv_Construct "*NotM:M:%g" iModIdx)) == 1
					let iTry := 0
					while iTry < 8
						let sName := Call rPick rActor (sPool) iTry
						if eval (sv_Length sName) == 0
							break
						endif
						if eval (rPlayer.AuxVarGetFlt "*NotM:ShowRole") == 1
							let sName := sName + " (" + sBase + ")"
						endif
						if eval (ar_HasKey aUsed sName) == 0
							break
						endif
						let iTry += 1
					loop
					if eval (sv_Length sName) > 0
						rActor.SetRefName (sName)
						let aUsed[sName] := 1
						if eval (rPlayer.AuxVarGetFlt "*NotM:Debug") == 1
							PrintToConsole "[NotM] %i %z -> %z (try %g)" rActor sBase sName iTry
						endif
						let iCount += 1
					endif
				endif
			endif
		endif
		let rActor := GetNextRef
	loop
	if eval iCount > 0 && (rPlayer.AuxVarGetFlt "*NotM:Debug") == 1
		PrintToConsole "[NotM] named %g actors" iCount
	endif
end
