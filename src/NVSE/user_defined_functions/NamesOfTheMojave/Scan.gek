; GECK wiki stuff:
;   - https://geckwiki.com/index.php?title=GetFirstRef
;   - https://geckwiki.com/index.php?title=GetNextRef
;   - https://geckwiki.com/index.php?title=GetLeveledActorBase
;   - https://geckwiki.com/index.php?title=GetSourceModIndex

ref rNPC                    ; The NPC we are looking at
ref rNPCTemplate            ; The NPC's template (the record the game made it from)
ref rNameNPCScript          ; The namer for one NPC (NameNPC.gek)
ref rShowNameScript         ; Shows the name on the NPC (ShowName.gek)
array_var aNamesInUse       ; Every name in use nearby, so we do not give out the same name twice
int iPluginIndex            ; Which plugin the NPC comes from (its load order number)
string_var sOriginalName    ; The NPC's original name, I.E. 'Powder Ganger'
string_var sCurrentName     ; The name the NPC shows right now
string_var sGivenName       ; The name we gave the NPC, without the role (empty if we never named them)
string_var sRulePools       ; Which pools to use, from the rule (I.E. 'NOTM_wasteland')
float fPlaythroughSeed      ; The playthrough number. An NPC named with another number gets a new name
float fUseTitles            ; 1 = rule titles on. An NPC named with the other setting gets a new name

; This names the NPC's around the player
; Logic for this to satisfy a rename:
;   - If it's a person & not the player
;   - If it's got a name in the rules files
;   - If it comes from a plugin listed in the plugin files
;   - If nobody has renamed it yet
begin Function {}
    let rNameNPCScript := player.AuxVarGetRef "*NotM:NameNPC"
    let rShowNameScript := player.AuxVarGetRef "*NotM:ShowName"
    let aNamesInUse := ar_Construct "stringmap"
    let fPlaythroughSeed := player.AuxVarGetFlt "NotMSeed"
    let fUseTitles := player.AuxVarGetFlt "*NotM:UseTitles"

    ; ==============================================
    ; Round 1: note the names already in use
    ; ==============================================

    ; Loop through and find all the names in use
    ; 42 = NPCs only (no creatures), 2 = the 5x5 cells loaded around you (vanilla uGridsToLoad)
    let rNPC := GetFirstRef 42 2
    while rNPC
        let sCurrentName := rNPC.LNGetName
        ; NPCs we named count by the name without the role (NameNPC checks repeats that way)
        let sGivenName := rNPC.AuxVarGetStr "*NotM:GivenName"
        if eval sCurrentName == sGivenName || sCurrentName == (sGivenName + " (" + (rNPC.GetName) + ")")
            let aNamesInUse[sGivenName] := 1
        else
            let aNamesInUse[sCurrentName] := 1
        endif
        let rNPC := GetNextRef
    loop

    ; ==============================================
    ; Round 2: name the NPCs that need it
    ; ==============================================

    ; Second loop to loop through names and change if required
    let rNPC := GetFirstRef 42 2
    while rNPC
        ; GetName = original name, LNGetName = current name. Same = nobody has renamed them yet
        let sOriginalName := rNPC.GetName ; Original Name
        let sCurrentName := rNPC.LNGetName ; Current name

        let sGivenName := rNPC.AuxVarGetStr "*NotM:GivenName"

        if eval rNPC != player && (rNPC.AuxVarGetFlt "NotMSkip") == 0
            if eval sCurrentName == sOriginalName
                ; Does this name have a rule? Empty = no rule, so leave the NPC alone
                let sRulePools := player.AuxVarGetStr ("*NotM:Rule:" + sOriginalName)

                if eval (sv_Length sRulePools) > 0
                    ; Is the NPC from a listed plugin? Check the template, not the
                    ; temporary copy the game makes for random spawns
                    let rNPCTemplate := rNPC.GetLeveledActorBase
                    let iPluginIndex := GetSourceModIndex rNPCTemplate

                    if eval (player.AuxVarGetFlt (sv_Construct "*NotM:UsePlugin:%g" iPluginIndex)) == 1
                        Call rNameNPCScript rNPC (sOriginalName) (sRulePools) aNamesInUse
                    endif
                endif
            elseif eval sCurrentName == sGivenName || sCurrentName == (sGivenName + " (" + sOriginalName + ")")
                ; We named them already. A name from another mod does not match, so it is left alone
                if eval (rNPC.AuxVarGetFlt "*NotM:Seed") != fPlaythroughSeed || (rNPC.AuxVarGetFlt "*NotM:UseTitles") != fUseTitles
                    ; The seed or UseTitles changed (MCM): give them a name from the new settings
                    Call rNameNPCScript rNPC (sOriginalName) (player.AuxVarGetStr ("*NotM:Rule:" + sOriginalName)) aNamesInUse
                else
                    ; Show the name again, so a ShowRole change (MCM) reaches them
                    Call rShowNameScript rNPC
                endif
            endif
        endif

        let rNPC := GetNextRef
    loop
end
