string_var sPoolName        ; The pool to load, I.E. 'NOTM_wasteland'
ref rReadLinesScript        ; The file reader (ReadLines.gek)
string_var sFolderPath      ; The pool's folder, I.E. "Data/Config/NamesOfTheMojave/Names/NOTM_wasteland/"
string_var sNotePrefix      ; The start of the pool's note names, I.E. "*NotM:NOTM_wasteland:"
int iMaleCount              ; Names in male.txt
int iMaleFullCount          ; Names in male_full.txt
int iFemaleCount            ; Names in female.txt
int iFemaleFullCount        ; Names in female_full.txt

; Loads a single pool of names
begin Function {sPoolName}
    ; Get the file reader, and build the folder path and note prefix for this pool's files
    let rReadLinesScript := player.AuxVarGetRef "*NotM:ReadLines"
    let sFolderPath := "Data/Config/NamesOfTheMojave/Names/" + sPoolName + "/"
    let sNotePrefix := "*NotM:" + sPoolName + ":"

    ; SO we use male names as the default, so we need to get the count of male / male full name counts
    let iMaleCount := Call rReadLinesScript (sFolderPath + "male.txt") (sNotePrefix + "male")
    let iMaleFullCount := Call rReadLinesScript (sFolderPath + "male_full.txt") (sNotePrefix + "male_full")

    ; Female names and surnames are optional. A missing file gives 0 names
    let iFemaleCount := Call rReadLinesScript (sFolderPath + "female.txt") (sNotePrefix + "female")
    let iFemaleFullCount := Call rReadLinesScript (sFolderPath + "female_full.txt") (sNotePrefix + "female_full")
    ; The surname count is not kept: PickName reads it from the note when it needs it
    Call rReadLinesScript (sFolderPath + "surname.txt") (sNotePrefix + "surname")

    ; Total names = how often this pool is picked when a rule has several pools
    player.AuxVarSetFlt ("*NotM:NameCount:" + sPoolName) (iMaleCount + iMaleFullCount + iFemaleCount + iFemaleFullCount)
end
